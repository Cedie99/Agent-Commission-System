{
  "name": "@ocs/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Pure commission engine. No DB / framework / IO. RuleSet + data in, results out.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ocs/shared": "workspace:*",
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "typescript": "~5.6.3",
    "vitest": "^2.1.5"
  }
}
