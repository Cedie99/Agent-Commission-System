{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": "dist",
    "rootDir": ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "noUncheckedIndexedAccess": false,
    "types": ["node", "multer"]
  },
  "include": ["src", "test", "prisma/seed.ts", "scripts"]
}
