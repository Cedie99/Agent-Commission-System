# Copy to apps/api/.env (Prisma and the API read it from there).

# Native PostgreSQL (no Docker). Create the DB with:
#   psql -U postgres -c "CREATE ROLE commission LOGIN PASSWORD 'commission' CREATEDB;"
#   psql -U postgres -c "CREATE DATABASE commission_dev OWNER commission;"
DATABASE_URL="postgresql://commission:commission@localhost:5432/commission_dev?schema=public"

# API
API_PORT=3000
JWT_SECRET="change-me-in-every-environment"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:5173"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=20

# Seed passwords (dev only)
SEED_DEFAULT_PASSWORD="ChangeMe123!"

# Web (read by Vite; put in apps/web/.env if overriding)
VITE_API_URL="http://localhost:3000"
