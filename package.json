{
  "name": "commission-system",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm -r --filter ./apps/** build",
    "build:packages": "pnpm -r --filter ./packages/** build",
    "dev": "pnpm build:packages && pnpm -r --parallel dev",
    "test": "pnpm build:packages && pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @ocs/api prisma:migrate",
    "db:deploy": "pnpm --filter @ocs/api prisma:deploy",
    "db:seed": "pnpm --filter @ocs/api prisma:seed",
    "db:reset": "pnpm --filter @ocs/api prisma:reset",
    "samples": "pnpm --filter @ocs/api exec tsx ../../scripts/make-samples.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.14.0"
  }
}
